meta {
  name: Subscribe - accès refusé (coach)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/memberships
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "pricing_id": {{pricingId}},
    "payment_mode": "MONTHLY"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
