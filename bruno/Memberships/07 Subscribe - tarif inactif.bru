meta {
  name: Subscribe - tarif inactif
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/memberships
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "pricing_id": {{inactivePricingId}},
    "payment_mode": "MONTHLY"
  }
}

tests {
  test("status is 400", function() {
    expect(res.status).to.equal(400);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
