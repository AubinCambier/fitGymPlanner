meta {
  name: Subscribe - abonnement déjà actif
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/memberships
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "pricing_id": {{pricingId}},
    "payment_mode": "MONTHLY"
  }
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
