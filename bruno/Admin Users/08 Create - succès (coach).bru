meta {
  name: Create - succès (coach)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "email": "coach2@fitgym.com",
    "password": "password123",
    "first_name": "Marc",
    "last_name": "Dupont",
    "role": "COACH"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("targetUserId", res.body.data.id);
  }
}
