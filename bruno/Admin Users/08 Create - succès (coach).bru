meta {
  name: Create - succès (coach)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  bru.setEnvVar("newCoachEmail", "coach_" + Date.now() + "@fitgym.com");
}

body:json {
  {
    "email": "{{newCoachEmail}}",
    "password": "password123",
    "first_name": "Marc",
    "last_name": "Dupont",
    "role": "COACH"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("targetUserId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
