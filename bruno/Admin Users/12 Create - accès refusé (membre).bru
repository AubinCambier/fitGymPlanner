meta {
  name: Create - accès refusé (membre)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "email": "nouveau@fitgym.com",
    "password": "password123",
    "first_name": "Test",
    "last_name": "User",
    "role": "COACH"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
