meta {
  name: Update - email déjà utilisé
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/api/v1/admin/users/{{targetUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "email": "membre@fitgym.com"
  }
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
