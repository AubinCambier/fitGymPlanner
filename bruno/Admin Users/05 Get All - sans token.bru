meta {
  name: Get All - sans token
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/users
  body: none
  auth: none
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
