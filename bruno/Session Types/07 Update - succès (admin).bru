meta {
  name: Update - succès (admin)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/session-types/{{newSessionTypeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Yoga Flow",
    "description": "Yoga dynamique"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
