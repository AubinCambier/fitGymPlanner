meta {
  name: Create - accès refusé (coach)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "session_id": {{sessionId}}
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
