meta {
  name: Get All Admin - accès refusé (membre)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/pricing
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
