meta {
  name: Set Status - introuvable
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/admin/pricing/99999/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "is_active": false
  }
}

tests {
  test("status is 404", function() {
    expect(res.status).to.equal(404);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
