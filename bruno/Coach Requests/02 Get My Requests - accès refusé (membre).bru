meta {
  name: Get My Requests - accès refusé (membre)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/coach/requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
