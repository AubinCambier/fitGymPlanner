meta {
  name: Create - demande déjà existante
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/coach/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "session_id": {{sessionId}},
    "reason": "Doublon de demande"
  }
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
