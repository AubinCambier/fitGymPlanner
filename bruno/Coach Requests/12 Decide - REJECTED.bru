meta {
  name: Decide - REJECTED
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/admin/requests/{{requestId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "REJECTED",
    "admin_comment": "La session peut encore être maintenue, un remplaçant est disponible"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
