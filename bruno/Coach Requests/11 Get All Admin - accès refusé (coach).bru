meta {
  name: Get All Admin - accès refusé (coach)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/admin/requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
