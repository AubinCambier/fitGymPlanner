meta {
  name: Create - accès refusé (membre)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/coach/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "session_id": {{sessionId}},
    "reason": "Tentative non autorisée"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
