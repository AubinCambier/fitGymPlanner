meta {
  name: Register - succès
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}",
    "password": "password123",
    "first_name": "Alice",
    "last_name": "Dupont"
  }
}

script:pre-request {
  bru.setEnvVar("memberEmail", "membre_" + Date.now() + "@fitgym.com");
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}

