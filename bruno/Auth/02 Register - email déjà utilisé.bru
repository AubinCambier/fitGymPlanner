meta {
  name: Register - email déjà utilisé
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}",
    "password": "password123",
    "first_name": "Alice",
    "last_name": "Dupont"
  }
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
