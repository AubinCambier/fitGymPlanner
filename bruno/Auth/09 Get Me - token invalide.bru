meta {
  name: Get Me - token invalide
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: token.faux.invalide
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
