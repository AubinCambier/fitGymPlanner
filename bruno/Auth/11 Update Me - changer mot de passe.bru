meta {
  name: Update Me - changer mot de passe
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/v1/auth/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "password": "nouveaumdp123"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
}
