meta {
  name: Register membre
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}",
    "password": "password123",
    "first_name": "Test",
    "last_name": "Membre"
  }
}

script:pre-request {
  bru.setEnvVar("memberEmail", "setup_membre_" + Date.now() + "@fitgym.com");
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("targetUserId", res.body.data.id);
  }
}

tests {
  test("register membre réussi", function() {
    expect(res.status).to.equal(201);
  });
}
