meta {
  name: Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@fitgym.com",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("adminToken", res.body.data.token);
  }
}

tests {
  test("admin login réussi", function() {
    expect(res.status).to.equal(200);
  });
}
