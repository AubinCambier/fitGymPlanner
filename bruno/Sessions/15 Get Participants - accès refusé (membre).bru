meta {
  name: Get Participants - accès refusé (membre)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/participants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
