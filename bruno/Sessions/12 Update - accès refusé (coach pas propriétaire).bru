meta {
  name: Update - accès refusé (coach pas propriétaire)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/v1/sessions/{{notMySessionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "title": "Tentative de modification"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
