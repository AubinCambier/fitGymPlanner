meta {
  name: Get Participants - succès (admin)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/participants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
