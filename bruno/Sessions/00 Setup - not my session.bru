meta {
  name: Setup - not my session
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "title": "Session autre coach",
    "description": "Session appartenant au coach dynamique",
    "session_type_id": 2,
    "coach_id": {{targetUserId}},
    "start_time": "2026-07-01T10:00:00+00:00",
    "end_time": "2026-07-01T11:00:00+00:00",
    "capacity": 10,
    "intensity": "MEDIUM"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("notMySessionId", res.body.data.id);
  }
}

tests {
  test("not my session créée", function() {
    expect(res.status).to.equal(201);
  });
}
