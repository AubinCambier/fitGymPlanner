meta {
  name: Create - succès (BAN) - user désactivé
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/sanctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "user_id": {{targetUserId}},
    "sanction_type": "BAN",
    "reason": "Fraude grave"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("sanctionId", res.body.data.id);
  }
}
