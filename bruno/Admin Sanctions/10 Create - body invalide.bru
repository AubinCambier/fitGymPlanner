meta {
  name: Create - body invalide
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/admin/sanctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "user_id": {{targetUserId}},
    "sanction_type": "INVALID_TYPE",
    "reason": ""
  }
}

tests {
  test("status is 400", function() {
    expect(res.status).to.equal(400);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
