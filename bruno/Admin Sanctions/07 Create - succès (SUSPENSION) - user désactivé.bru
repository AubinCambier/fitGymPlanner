meta {
  name: Create - succès (SUSPENSION) - user désactivé
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/sanctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "user_id": {{targetUserId}},
    "sanction_type": "SUSPENSION",
    "reason": "Absences répétées sans annulation",
    "end_date": "2026-05-31T23:59:59+00:00"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("sanctionId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
