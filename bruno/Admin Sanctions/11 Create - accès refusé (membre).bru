meta {
  name: Create - accès refusé (membre)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/admin/sanctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "user_id": {{targetUserId}},
    "sanction_type": "WARNING",
    "reason": "Tentative non autorisée"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
