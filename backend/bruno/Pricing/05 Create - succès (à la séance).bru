meta {
  name: Create - succès (à la séance)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/pricing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "label": "Séance à l'unité",
    "payment_mode": "PAY_PER_SESSION",
    "price": 15.00
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
