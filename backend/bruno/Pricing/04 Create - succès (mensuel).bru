meta {
  name: Create - succès (mensuel)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/pricing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "label": "Abonnement mensuel",
    "payment_mode": "MONTHLY",
    "price": 49.90,
    "currency": "EUR"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("pricingId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
