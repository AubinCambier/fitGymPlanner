meta {
  name: Get Participants - session introuvable
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/coach/sessions/99999/participants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 404", function() {
    expect(res.status).to.equal(404);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
