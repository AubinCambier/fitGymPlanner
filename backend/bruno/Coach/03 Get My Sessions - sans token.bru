meta {
  name: Get My Sessions - sans token
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/coach/sessions
  body: none
  auth: none
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
