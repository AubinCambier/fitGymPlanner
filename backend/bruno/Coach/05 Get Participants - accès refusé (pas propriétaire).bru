meta {
  name: Get Participants - accès refusé (pas propriétaire)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/coach/sessions/{{sessionId}}/participants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
