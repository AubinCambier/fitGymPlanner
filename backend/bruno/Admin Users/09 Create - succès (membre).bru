meta {
  name: Create - succès (membre)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  bru.setEnvVar("newMembreEmail", "membre_" + Date.now() + "@fitgym.com");
}

body:json {
  {
    "email": "{{newMembreEmail}}",
    "password": "password123",
    "first_name": "Sophie",
    "last_name": "Martin",
    "role": "MEMBER"
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
