meta {
  name: Set Status - désactiver
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{targetUserId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "is_active": false
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
}
