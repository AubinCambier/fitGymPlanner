meta {
  name: Create - succès (coach)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/coach/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

body:json {
  {
    "session_id": {{sessionId}},
    "reason": "Indisponibilité imprévue du coach"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("requestId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
