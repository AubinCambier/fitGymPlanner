meta {
  name: Get My Requests - succès (coach)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/coach/requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
