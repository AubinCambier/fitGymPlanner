meta {
  name: Create - succès
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "session_id": {{sessionId}}
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("bookingId", res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
}
