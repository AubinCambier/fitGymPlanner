meta {
  name: Cancel - déjà annulée
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
