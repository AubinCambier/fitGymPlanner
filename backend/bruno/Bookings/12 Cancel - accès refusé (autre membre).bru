meta {
  name: Cancel - accès refusé (autre membre)
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
