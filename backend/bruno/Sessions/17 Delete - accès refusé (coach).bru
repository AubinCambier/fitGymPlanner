meta {
  name: Delete - accès refusé (coach)
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
