meta {
  name: Cancel - aucun abonnement actif
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/memberships/me/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 404", function() {
    expect(res.status).to.equal(404);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
