meta {
  name: Create review - invalid body (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "booking_id": "not-a-number",
    "rating": 10
  }
}

tests {
  test("status is 400", function() {
    expect(res.status).to.equal(400);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
