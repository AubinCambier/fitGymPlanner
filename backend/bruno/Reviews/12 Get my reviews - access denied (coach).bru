meta {
  name: Get my reviews - access denied (coach)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/reviews/mine
  body: none
  auth: bearer
}

auth:bearer {
  token: {{coachToken}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
  test("body status is error", function() {
    expect(res.body.status).to.equal("error");
  });
}
