meta {
  name: Login second membre
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail2}}",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("authToken2", res.body.data.token);
  }
}

tests {
  test("second member login ok", function() {
    expect(res.status).to.equal(200);
  });
}
