meta {
  name: Create past session
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "title": "Past Yoga Session",
    "description": "Session used for review tests",
    "session_type_id": 2,
    "coach_id": 2,
    "start_time": "2025-01-15T09:00:00+00:00",
    "end_time": "2025-01-15T10:00:00+00:00",
    "capacity": 15,
    "intensity": "LOW"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("pastSessionId", res.body.data.id);
    bru.setEnvVar("coachId", res.body.data.coach_id);
  }
}

tests {
  test("past session created", function() {
    expect(res.status).to.equal(201);
  });
}
