meta {
  name: Get my payments - success
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/payments/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body status is success", function() {
    expect(res.body.status).to.equal("success");
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
